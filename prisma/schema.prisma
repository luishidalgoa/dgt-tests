// DGT Tests - Schema
// SQLite + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Usuario ──────────────────────────────────────────────────────────────
// Roles: USER (free), SUBSCRIBER (suscripción activa), ADMIN (acceso total sin pagar).
// El rol SUBSCRIBER se gestiona automáticamente desde los webhooks de Stripe;
// ADMIN se asigna manualmente por script.
enum UserRole {
  USER
  SUBSCRIBER
  ADMIN
}

model User {
  id              Int           @id @default(autoincrement())
  username        String        @unique
  /// Email opcional. Lo añadimos en una actualización posterior al registro
  /// original; los usuarios antiguos no tienen email hasta que lo rellenen
  /// desde /settings.
  email           String?       @unique
  passwordHash    String
  displayName     String?
  createdAt       DateTime      @default(now())
  role            UserRole      @default(USER)
  // ── Quota mensual de tokens IA (Gemini). aiTokensMonth = "YYYY-MM".
  //    Al cambiar de mes, se resetea a 0.
  aiTokensUsed    Int           @default(0)
  aiTokensMonth   String        @default("")
  // ── Stripe (gestionado por el webhook, no tocar a mano) ─────────────
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  subscriptionStatus           String?   // "active" | "past_due" | "canceled" | "trialing" | "incomplete" | null
  subscriptionPriceId          String?
  subscriptionCurrentPeriodEnd DateTime?
  /// true = el usuario ha cancelado la suscripción y NO se renovará al
  /// final del periodo (subscriptionCurrentPeriodEnd marca el fin real).
  /// false = sigue activa y se renovará automáticamente al final del periodo.
  subscriptionCancelAtPeriodEnd Boolean  @default(false)
  // ── UX ────────────────────────────────────────────────────────────
  hasSeenWelcome  Boolean       @default(false)   // legacy, no usado; ver acknowledgments
  /** JSON String[] con los ids de notificaciones que el usuario ya ha
   *  marcado como vistas (welcome, actualizaciones de términos, etc.).
   *  Ver src/lib/notifications.ts para el registro. */
  acknowledgments String        @default("[]")
  attempts        ExamAttempt[]
  hostedParties   Party[]       @relation("HostedParties")
  partyPlays      PartyPlayer[] @relation("PartyParticipations")
  aiPaid          UserAiPaid[]
  configUpdates   AppConfig[]   @relation("AppConfigUpdates")

  @@map("users")
}


// ── Categoría / Familia de exámenes ──────────────────────────────────────
model Category {
  id          Int     @id @default(autoincrement())
  code        String  @unique          // "134" | "434" | "501"
  slug        String  @unique          // "permiso-b" | "repaso-final" | "adas"
  name        String                   // "Examen permiso B"
  description String?
  tests       Test[]
  parties     Party[]

  @@map("categories")
}

// ── Test (un examen de 30 preguntas) ─────────────────────────────────────
model Test {
  id             Int      @id @default(autoincrement())
  categoryId     Int
  testNumber     Int                  // 1..88 / 1..15 / 501
  totalQuestions Int
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  testQuestions  TestQuestion[]
  attempts       ExamAttempt[]

  @@unique([categoryId, testNumber])
  @@map("tests")
}

/// Tier de acceso para una pregunta.
/// - FREE: accesible para cualquier usuario (incluido el plan gratuito)
/// - PRO:  requiere suscripción activa (o ser ADMIN)
/// El PRO "hereda" del FREE: un PRO accede a todo, un FREE solo a FREE.
enum ContentTier {
  FREE
  PRO
}

// ── Pregunta (única por externalId, compartida entre tests) ─────────────
model Question {
  id            Int            @id @default(autoincrement())
  externalId    String         @unique       // id_pregunta de AEOL (ej. "320671") o "ai-{uuid}" para generadas
  codigoTema    String?                       // "TC 7.3-3.1.3 (7-3.3.1)"
  enunciado     String
  explicacion   String
  imagen        String?                       // "320671.png"
  tier          ContentTier    @default(PRO)  // marcadas FREE solo las de los 7 primeros tests permiso-b

  // ── Preguntas generadas por IA (Fase 107) ──────────────────────────
  //  - aiGenerated=false  → pregunta humana original (de AEOL).
  //  - aiGenerated=true   → generada por LLM; requiere review.
  //  - aiApproved=null    → pendiente de review (NO visible a usuarios).
  //  - aiApproved=true    → revisada y aprobada (visible).
  //  - aiApproved=false   → descartada (NO visible, se mantiene en BBDD por auditoría).
  aiGenerated   Boolean        @default(false)
  aiModel       String?                        // p.ej. "gemini-2.5-flash" — para auditoría/debug
  aiReviewedAt  DateTime?
  aiApproved    Boolean?                       // null = pendiente

  options       Option[]
  testQuestions TestQuestion[]
  answers       Answer[]
  partyAnswers  PartyAnswer[]
  aiPaid        UserAiPaid[]

  @@index([tier])
  // Acelera el filtro "preguntas visibles a usuario" en /temas, /test-errores, etc.
  @@index([aiGenerated, aiApproved])
  @@map("questions")
}

// ── Relación N:M Test ↔ Question con orden ───────────────────────────────
model TestQuestion {
  testId     Int
  questionId Int
  order      Int                        // 1..30 dentro del test
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@unique([testId, order])
  @@map("test_questions")
}

// ── Opción de respuesta ──────────────────────────────────────────────────
model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  letra      String                    // "A" | "B" | "C"
  texto      String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@unique([questionId, letra])
  @@map("options")
}

// ── Intento de examen ────────────────────────────────────────────────────
model ExamAttempt {
  id         Int       @id @default(autoincrement())
  userId     Int
  testId     Int?                     // null si mode="errores"
  mode       String    @default("normal") // "normal" | "errores"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?                     // nº de aciertos (null hasta finalizar)
  total      Int                      // nº de preguntas en el intento
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test       Test?     @relation(fields: [testId], references: [id], onDelete: SetNull)
  answers    Answer[]
  aiPaid     UserAiPaid[]

  @@index([userId, startedAt])
  @@index([userId, testId])
  @@map("exam_attempts")
}

// ── Sección del manual del temario ──────────────────────────────────────
model ManualSection {
  id           Int      @id @default(autoincrement())
  temaCode     String                                  // "1"
  temaName     String                                  // "1 EL USO DE LAS VÍAS"
  subtemaCode  String   @unique                        // "1.1"
  subtemaName  String                                  // "El uso compartido..."
  folder       String                                  // "tema_1_1" → /public/manual/tema_1_1/
  pages        String                                  // JSON: [{ filename, page_in_book, ... }]
  totalPages   Int
  pdfFilename  String?                                 // opcional, por si en el futuro queremos enlazar al PDF

  @@index([subtemaCode])
  @@index([temaCode])
  @@map("manual_sections")
}


// ── Respuesta individual ─────────────────────────────────────────────────
model Answer {
  id               Int         @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?                // null si lo dejó en blanco
  isCorrect        Boolean
  answeredAt       DateTime    @default(now())
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([questionId, answeredAt])  // clave para "errores recientes"
  @@map("answers")
}


// ═══════════════════════════════════════════════════════════════════════════
//  PARTY MODE — competición multi-jugador
// ═══════════════════════════════════════════════════════════════════════════

model Party {
  id              Int           @id @default(autoincrement())
  code            String        @unique                  // 6 chars, p.ej. "AB12CD"
  hostUserId      Int
  categoryId      Int?
  totalQuestions  Int
  questionIds     String                                  // JSON array de question.id
  status          String        @default("waiting")       // waiting | playing | finished
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime      @default(now())
  host            User          @relation("HostedParties", fields: [hostUserId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  players         PartyPlayer[]

  @@index([code])
  @@index([hostUserId])
  @@map("parties")
}

model PartyPlayer {
  id           Int            @id @default(autoincrement())
  partyId      Int
  userId       Int?                                       // null si es guest
  guestName    String?                                    // nombre del guest si userId es null
  guestToken   String?        @unique                     // UUID para identificar al guest entre requests
  joinedAt     DateTime       @default(now())
  startedAt    DateTime?                                  // cuando empieza a responder
  finishedAt   DateTime?                                  // cuando termina todas las preguntas
  party        Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user         User?          @relation("PartyParticipations", fields: [userId], references: [id], onDelete: SetNull)
  answers      PartyAnswer[]

  @@index([partyId])
  @@map("party_players")
}

model PartyAnswer {
  id               Int          @id @default(autoincrement())
  partyPlayerId    Int
  questionId       Int
  selectedOptionId Int?
  isCorrect        Boolean
  timeMs           Int                                    // tiempo en ms desde que se mostró la pregunta
  answeredAt       DateTime     @default(now())
  player           PartyPlayer  @relation(fields: [partyPlayerId], references: [id], onDelete: Cascade)
  question         Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([partyPlayerId])
  @@map("party_answers")
}

// ── Cache de explicaciones generadas por IA ──────────────────────────────
// Una entrada por (questionId, withImage). El payload es JSON con la
// respuesta de Gemini: explicación principal, análisis de las otras
// opciones y frases clave a subrayar.
model AICacheEntry {
  id          Int      @id @default(autoincrement())
  questionId  Int
  withImage   Boolean  @default(false)
  payloadJson String                  // JSON serializado: { main, others, keyPhrases }
  model       String   @default("gemini-flash-latest")
  createdAt   DateTime @default(now())

  @@unique([questionId, withImage])
  @@map("ai_cache_entries")
}

// ── Config runtime de la aplicación (panel admin) ──────────────────────
// Cosas que el admin puede cambiar sin redeploy: quotas, feature flags,
// API keys (cifradas con AES-256-GCM via APP_MASTER_KEY), textos UI…
//
// Convención: la `key` es un string identificador (p. ej. "AI_TOKENS_PRO",
// "FEATURE_COMPETIR", "STRIPE_SECRET_KEY"). El value:
//   - Si encrypted=false → JSON string ("60", "true", "\"texto\"", etc.)
//   - Si encrypted=true  → envelope crypto.ts (iv:tag:ct base64)
//
// El src/lib/appConfig.ts wrapea get/set con tipado y descifrado.
model AppConfig {
  key       String    @id
  value     String
  encrypted Boolean   @default(false)
  updatedAt DateTime  @updatedAt
  /// Id del admin que cambió el valor por última vez (null = seed inicial).
  updatedBy Int?
  updatedByUser User? @relation("AppConfigUpdates", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("app_config")
}

// ── Registro per-user de "ya pagué por esta explicación IA" ──────────────
// El cobro de 1 token solo ocurre la PRIMERA vez que un user pide la
// explicación de una pregunta EN UN CONTEXTO DADO. Contexto = attemptId.
//   - attemptId = null → modo práctica (o cualquier sitio sin contexto).
//                        Una sola compra por (user, question, withImage)
//                        — gratis para siempre. Comportamiento Fase 77.
//   - attemptId = X    → atado al ExamAttempt X. Re-ver el mismo attempt
//                        es gratis; un attempt NUEVO del mismo test
//                        vuelve a cobrar.
//
// El cache global (AICacheEntry) sigue existiendo y ahorra dinero de
// Gemini. Esta tabla es ortogonal: trackea quién pagó qué.
//
// La unicidad se gestiona con partial unique indexes en SQL (uno para
// attemptId IS NULL, otro para attemptId IS NOT NULL); Prisma no expone
// partial indexes en el schema, por eso no hay @@unique aquí.
model UserAiPaid {
  id          Int          @id @default(autoincrement())
  userId      Int
  questionId  Int
  withImage   Boolean      @default(false)
  /// null = modo práctica; X = pago atado al ExamAttempt #X.
  attemptId   Int?
  paidAt      DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt     ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([attemptId])
  @@map("user_ai_paid")
}
