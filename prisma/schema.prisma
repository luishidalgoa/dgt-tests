// DGT Tests - Schema
// SQLite + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Categoría / Familia de exámenes ──────────────────────────────────────
model Category {
  id          Int    @id @default(autoincrement())
  code        String @unique          // "134" | "434" | "501"
  slug        String @unique          // "permiso-b" | "repaso-final" | "adas"
  name        String                  // "Examen permiso B"
  description String?
  tests       Test[]

  @@map("categories")
}

// ── Test (un examen de 30 preguntas) ─────────────────────────────────────
model Test {
  id             Int      @id @default(autoincrement())
  categoryId     Int
  testNumber     Int                  // 1..88 / 1..15 / 501
  totalQuestions Int
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  testQuestions  TestQuestion[]
  attempts       ExamAttempt[]

  @@unique([categoryId, testNumber])
  @@map("tests")
}

// ── Pregunta (única por externalId, compartida entre tests) ─────────────
model Question {
  id            Int       @id @default(autoincrement())
  externalId    String    @unique       // id_pregunta de AEOL (ej. "320671")
  codigoTema    String?                  // "TC 7.3-3.1.3 (7-3.3.1)"
  enunciado     String
  explicacion   String
  imagen        String?                  // "320671.png"
  options       Option[]
  testQuestions TestQuestion[]
  answers       Answer[]

  @@map("questions")
}

// ── Relación N:M Test ↔ Question con orden ───────────────────────────────
model TestQuestion {
  testId     Int
  questionId Int
  order      Int                        // 1..30 dentro del test
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@unique([testId, order])
  @@map("test_questions")
}

// ── Opción de respuesta ──────────────────────────────────────────────────
model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  letra      String                    // "A" | "B" | "C"
  texto      String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@unique([questionId, letra])
  @@map("options")
}

// ── Intento de examen ────────────────────────────────────────────────────
model ExamAttempt {
  id         Int       @id @default(autoincrement())
  testId     Int?                     // null si mode="errores"
  mode       String    @default("normal") // "normal" | "errores"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?                     // nº de aciertos (null hasta finalizar)
  total      Int                      // nº de preguntas en el intento
  test       Test?     @relation(fields: [testId], references: [id], onDelete: SetNull)
  answers    Answer[]

  @@index([startedAt])
  @@map("exam_attempts")
}

// ── Sección del manual del temario ──────────────────────────────────────
model ManualSection {
  id           Int      @id @default(autoincrement())
  temaCode     String                                  // "1"
  temaName     String                                  // "1 EL USO DE LAS VÍAS"
  subtemaCode  String   @unique                        // "1.1"
  subtemaName  String                                  // "El uso compartido..."
  folder       String                                  // "tema_1_1" → /public/manual/tema_1_1/
  pages        String                                  // JSON: [{ filename, page_in_book, ... }]
  totalPages   Int
  pdfFilename  String?                                 // opcional, por si en el futuro queremos enlazar al PDF

  @@index([subtemaCode])
  @@index([temaCode])
  @@map("manual_sections")
}


// ── Respuesta individual ─────────────────────────────────────────────────
model Answer {
  id               Int         @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?                // null si lo dejó en blanco
  isCorrect        Boolean
  answeredAt       DateTime    @default(now())
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([questionId, answeredAt])  // clave para "errores recientes"
  @@map("answers")
}
