{
  "name": "dgt-tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "help": "tsx scripts/help.ts",
    "?": "tsx scripts/help.ts",
    "dev": "next dev -p 4321",
    "dev:reset": "prisma generate && echo \"\nPrisma client regenerado. AHORA reinicia 'npm run dev'.\"",
    "build": "prisma generate && next build",
    "start": "next start -p 4321",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:push": "prisma db push",
    "turso:init": "tsx --env-file=.env scripts/turso-init.ts",
    "turso:sync": "tsx --env-file=.env scripts/turso-sync.ts",
    "turso:apply-migration": "tsx --env-file=.env scripts/turso-apply-migration.ts",
    "turso:sync-ai-questions": "tsx --env-file=.env scripts/turso-sync-ai-questions.ts",
    "turso:sync-question": "tsx --env-file=.env scripts/turso-sync-question.ts",
    "db:pull-prod": "tsx --env-file=.env scripts/db-pull-prod.ts",
    "user:seed": "tsx --env-file=.env scripts/seed-user.ts",
    "user:role": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/set-role.ts",
    "user:role:prod": "tsx --env-file=.env scripts/set-role.ts",
    "user:fake-subscribe": "tsx --env-file=.env scripts/fake-subscribe.ts",
    "user:lowercase": "tsx --env-file=.env scripts/lowercase-usernames.ts",
    "user:clear-stripe": "tsx --env-file=.env scripts/clear-user-stripe.ts",
    "dev:prepare-test-user": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/dev-prepare-test-user.ts",
    "dev:send-test-email": "tsx --env-file=.env scripts/dev-send-test-email.ts",
    "attempts:cleanup-orphan": "tsx --env-file=.env scripts/cleanup-orphan-attempts.ts",
    "user-ai-paid:backfill": "tsx --env-file=.env scripts/backfill-user-ai-paid.ts",
    "questions:tag-tiers": "tsx --env-file=.env scripts/tag-question-tiers.ts",
    "questions:audit": "tsx --env-file=.env scripts/audit-question-correctness.ts",
    "stripe:check": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/test-stripe.ts",
    "stripe:sync-user": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/sync-subscription-from-stripe.ts",
    "stripe:setup-test": "tsx --env-file=.env.local scripts/setup-stripe-test.ts",
    "stripe:audit": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/audit-stripe-customers.ts",
    "stripe:listen": "stripe listen --forward-to http://localhost:4321/api/webhooks/stripe",
    "images:upload-r2": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/upload-images-to-r2.ts",
    "images:download-r2": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/download-images-from-r2.ts",
    "images:clean-r2": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/clean-r2-images.ts",
    "images:upload-metadata": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/upload-metadata-to-r2.ts",
    "images:download-metadata": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/download-metadata-from-r2.ts",
    "images:audit-sha": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/audit-images-sha.ts",
    "images:audit-feedback": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/audit-image-feedback.ts",
    "images:bulk-save-refs": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/bulk-save-references.ts",
    "images:purge-refs": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/purge-references.ts",
    "images:diff-classification": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/diff-classification.ts",
    "images:classify": "cd tools/image-classifier && .venv\\Scripts\\python.exe classify_siglip.py",
    "images:classify-hf": "cd tools/image-classifier && .venv\\Scripts\\python.exe classify_hf.py",
    "images:classify-modal": "cd tools/image-classifier && .venv\\Scripts\\modal.exe run modal_app.py::main",
    "images:refine-labels": "cd tools/image-classifier && .venv\\Scripts\\python.exe refine_labels.py",
    "images:compute-prototypes": "cd tools/image-classifier && .venv\\Scripts\\modal.exe run modal_app.py::compute_prototypes",
    "images:compute-prototypes-local": "cd tools/image-classifier && .venv\\Scripts\\python.exe compute_prototypes_local.py",
    "images:setup-classifier": "node -e \"const{execSync}=require('child_process');const p=process.platform==='win32'?'powershell -ExecutionPolicy Bypass -File tools/image-classifier/setup.ps1':'bash tools/image-classifier/setup.sh';execSync(p,{stdio:'inherit'})\"",
    "images:setup-modal": "cd tools/image-classifier && .venv\\Scripts\\modal.exe token new",
    "manual:import": "tsx --env-file=.env scripts/import-manual.ts",
    "manual:extract-skeleton": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/extract-manual-skeleton.ts",
    "manual:infer-titles": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/infer-subblock-titles.ts",
    "questions:generate": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/generate-questions.ts",
    "ingest": "npm run db:seed && npm run images:copy && npm run manual:import"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^5.7.284",
    "prisma": "^6.19.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pageflip": "^2.0.3",
    "react-pdf": "^10.4.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
