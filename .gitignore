# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (cache de browsers, reports, traces, storageState con sesión)
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# pnpm — este proyecto usa npm. Si por error corres pnpm, sus
# lockfiles no deben llegar al repo (confunden a Vercel y a CI).
pnpm-lock.yaml
pnpm-workspace.yaml

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local SQLite (los datos viven en Turso)
/prisma/dev.db
/prisma/dev.db-journal
/dev.db

# Carpetas con los datos fuente del scraper (ya importados a la DB)
/Preguntas tipo test
/banco_*

# Imágenes de preguntas DGT: ahora se sirven desde Cloudflare R2 (CDN).
# Si vuelves a generarlas con scripts/copy-images.ts (poco probable),
# las dejará aquí y git las ignora. Para subirlas a R2 usa images:setup-r2.
/public/images/

# Output del audit de imágenes (SHA-256, pHash, clasificación CLIP).
# Son JSONs grandes derivados de los binarios; se regeneran con
# `npm run images:audit-sha` y los siguientes pasos.
/tools/image-audit/

# Entorno virtual Python del clasificador SigLIP. Pesa varios GB (PyTorch
# CPU + modelo) y es regenerable con `pip install -r requirements.txt`.
/tools/image-classifier/.venv/
/tools/**/__pycache__/
/tools/**/*.pyc
